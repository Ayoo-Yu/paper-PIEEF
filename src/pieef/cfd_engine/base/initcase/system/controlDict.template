FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Make sure OpenFOAM utilities can load atmospheric boundary conditions
// and fvOptions when the case enables ABL-specific models.
libs            (atmosphericModels);

application     roughFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         ${endTime}; 

deltaT          ${deltaT};

writeControl    timeStep;

writeInterval   ${writeInterval};

purgeWrite      ${purgeWrite};

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

